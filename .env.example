PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/budgetmind_ai
# Used only by the API integration tests; database name must contain "test".
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/budgetmind_ai_test
ALLOW_TEST_DB_RESET=false
JWT_SECRET=replace_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Password reset email (SMTP). Configure with your email provider.
APP_BASE_URL=http://localhost:5000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM=BudgetMind AI <no-reply@example.com>
